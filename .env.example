# ============================================================
# InkloomGuard AI — Environment Configuration Template
# Copy to .env for local development. NEVER commit .env files.
# All variables below are server-side only; never prefix secrets with VITE_.
# ============================================================

# Server port (Render injects PORT automatically in production; defaults to 3000 locally)
PORT="3000"

# Runtime environment: "development" locally, "production" on Render
NODE_ENV="development"

# Public origin URLs & comma-separated allowed CORS origins.
# Keep http://localhost:3000 locally so email verification and password-reset links open your local server.
# In Render production, set APP_BASE_URL and CORS_ORIGINS to your https://<service>.onrender.com URL.
APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
CORS_ORIGINS=""

# Supabase PostgreSQL connection string (Transaction/Session pooler URI).
# Required in production (NODE_ENV=production). Keep commented locally to use SQLite inside DATA_DIR.
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Supabase Project URL & Server-Side Secret / Service-Role Key (sb_secret_... or service_role JWT; NEVER expose to frontend)
# Required in production (NODE_ENV=production). Keep commented locally to use local DATA_DIR/uploads.
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SECRET_KEY"

# Private Supabase Storage bucket name for logos, guideline docs, and visual assets
SUPABASE_STORAGE_BUCKET="inkloomguard-files"

# Secret used to sign and verify 7-day Bearer JWT authentication tokens (must be >= 32 random chars).
# Required in production. Keep commented locally to auto-generate and persist ${DATA_DIR}/.jwt_secret.
# JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_JWT_SECRET"

# Google Gemini API key & model used server-side for guideline extraction and compliance analysis
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Server-side timeout in milliseconds for Gemini API operations (positive integer, default: 120000 = 120 seconds).
# Applied server-side via @google/genai SDK httpOptions.timeout and AbortSignal.timeout; never expose to frontend code.
GEMINI_TIMEOUT_MS=120000

# Local development data directory ONLY (SQLite DB + local upload fallback when Supabase is unset).
# Disabled in production; never rely on DATA_DIR on Render Free (Render local disk is ephemeral).
DATA_DIR="./data"

# Transactional Email Delivery — Brevo HTTP API (POST https://api.brevo.com/v3/smtp/email over HTTPS)
# Server-side only; never prefix with VITE_. Ensure BREVO_SENDER_EMAIL is a verified sender in Brevo.
# Leave placeholders as-is if testing without outbound email; set real values in .env to send live local emails.
BREVO_API_KEY="REPLACE_WITH_YOUR_BREVO_API_KEY"
BREVO_SENDER_EMAIL="noreply@your-verified-domain.example"
BREVO_SENDER_NAME="InkloomGuard AI"
